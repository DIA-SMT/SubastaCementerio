{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "subasta-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "subasta-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "env": { "DATABASE_URL": "" },
      "port": 3000
    },
    {
      "name": "subasta-local-cidituc",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "3010"],
      "env": {
        "DATABASE_URL": "",
        "CIDITUC_HABILITADO": "1",
        "CIDITUC_LOGIN_URL": "http://localhost:5175",
        "CIDITUC_API_URL": "https://estadisticas.smt.gob.ar:5000",
        "CIDITUC_CALLBACK_URL": "http://localhost:3010/auth/cidituc/callback"
      },
      "port": 3010,
      "autoPort": false
    },
    {
      "name": "cidituc-login",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "C:/repo/cidituc", "run", "dev", "--", "--port", "5175", "--strictPort"],
      "env": {
        "VITE_APP_RUTA_BACK": "https://estadisticas.smt.gob.ar:5000",
        "VITE_APP_SUBASTA_CEMENTERIO_CALLBACK_URL": "http://localhost:3010/auth/cidituc/callback"
      },
      "port": 5175,
      "autoPort": false
    }
  ]
}
