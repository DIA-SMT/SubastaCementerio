# Sin DATABASE_URL la app corre en MODO LOCAL: base PGlite en .local/ con datos de ejemplo y
# correos en la consola. Para ingresar como oferente hacen falta las variables de Cidituc.
# Fuera del modo local, la consola NUNCA recibe correos ni datos personales.

# --- Supabase (producción o entorno de prueba) ---
# Cadena del pooler en modo transacción (puerto 6543). Panel de Supabase > Connect.
# La app fuerza la conexión cifrada (TLS) aunque la cadena no traiga sslmode.
# DATABASE_URL=postgresql://postgres.<ref>:<contraseña>@aws-0-<region>.pooler.supabase.com:6543/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Servidor propio (VPS, sin Supabase) --- scripts en scripts/servidor/
# DATABASE_URL apunta al PostgreSQL del mismo equipo y NO se definen las NEXT_PUBLIC_SUPABASE_*:
# el ingreso del panel y las fotos los resuelve la app. Conexión sin TLS (no sale de la máquina).
# DATABASE_URL=postgresql://subasta:<clave>@127.0.0.1:5432/subasta
# Firma de las sesiones del panel: 32 caracteres o más (openssl rand -base64 48). Obligatoria.
# SESION_PANEL_SECRETO=
# Carpeta de las fotos, fuera de las versiones para que sobrevivan a cada despliegue.
# CARPETA_SUBIDAS=/srv/subasta/compartido/subidas

# Opcional, recomendado: certificado raíz de Supabase (PEM) para verificar el servidor.
# Panel de Supabase > Project Settings > Database > SSL Configuration > Download certificate.
# Se pega el contenido del archivo, con saltos de línea reales o escritos como \n.
# Sin esta variable la conexión se cifra igual, pero no verifica el certificado.
# SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# URL pública del sitio (enlaces de los correos y códigos QR). Sin ella, o si apunta a una
# dirección local, los avisos por correo quedan pendientes y los carteles QR no sirven.
# NEXT_PUBLIC_URL_SITIO=https://subasta.ejemplo.gob.ar

# --- Ingreso de oferentes con Cidituc (Ciudadano Digital) ---
# Ver README, 3.3. CIDITUC_HABILITADO=1 recién cuando el login desplegado tenga la clave
# subasta-cementerio. El login va SIN #/login: lo agrega la app.
# CIDITUC_HABILITADO=1
# CIDITUC_LOGIN_URL=https://ciudaddigital.smt.gob.ar
# CIDITUC_API_URL=https://estadisticas.smt.gob.ar:5000
# CIDITUC_CALLBACK_URL=https://subasta-cementerio.vercel.app/auth/cidituc/callback
# Opcionales: la clave en el login (por defecto subasta-cementerio) y el certificado
# intermedio de Sectigo, si hubiera que reemplazar el que trae el código.
# CIDITUC_CLAVE_APP=subasta-cementerio
# CIDITUC_CA_PEM=

# Firma de las sesiones de los oferentes: 32 caracteres o más. Obligatoria en producción.
# Fuera de producción, sin ella se usa una aleatoria guardada en .local/.
# SESSION_SECRET=

# --- Avisos por correo ("te superaron") ---
# Sin estas dos variables, fuera del modo local los avisos quedan PENDIENTES (no se pierden ni
# se marcan como enviados) y el tablero del panel lo advierte. Se envían cuando se configuran.
# RESEND_API_KEY=
# CORREO_REMITENTE="Subasta solidaria <subasta@ejemplo.gob.ar>"

# --- Reintento de avisos (cron de Vercel, vercel.json) ---
# Cadena aleatoria de 16 caracteres o más. Vercel la manda a /api/avisos en el encabezado
# Authorization. Sin ella, /api/avisos responde 401 y los avisos con error no se reintentan.
# vercel.json lo corre una vez por día (lo que admite el plan Hobby); con Pro puede ser cada 10 minutos.
# CRON_SECRET=

# --- Migue, el asistente con IA del sitio (src/lib/migue/) ---
# Todas opcionales. Sin OPENROUTER_API_KEY, Migue contesta igual con los atajos (cuánto va una
# obra, cuándo cierra, cómo participar) y con el buscador por palabras, sin modelo.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Consultas al modelo por persona (IP) y entre todos, por hora. Pasado el tope, contesta el buscador.
# MIGUE_TOPE_PERSONA=20
# MIGUE_TOPE_GLOBAL=300
# Tablero de Migues de la Dirección de IA (organizacionDIA, slug subasta-cementerio): las dos o ninguna.
# MIGUE_API_KEY=
# MIGUE_DASHBOARD_URL=
